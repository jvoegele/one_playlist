# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
one_playlist-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/


# Dialyzer PLTs — large, machine-specific, and rebuildable.
/priv/plts/*.plt
/priv/plts/*.plt.hash

# Local development overrides — real provider credentials, never committed.
# Copy config/dev_local.example.exs to config/dev_local.exs and fill it in.
/config/dev_local.exs

# The local Navidrome instance: generated audio and its database. The generator
# and the compose file are committed; what they produce is not.
/dev/navidrome/music/
/dev/navidrome/data/

# Experiment scratch: which playlist and which transfer a dev script is pointed at.
dev/experiments/PLAYLIST
dev/experiments/TRANSFER
