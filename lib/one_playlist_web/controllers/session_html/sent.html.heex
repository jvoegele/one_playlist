<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="py-12">
    <h1 class="text-2xl font-semibold text-center mb-2">Check your email</h1>
    <p class="text-sm text-center opacity-70 mb-8 mx-auto max-w-sm">
      We sent a sign-in link and a six-digit code to <strong>{@email}</strong>.
      Open the link on any device, or enter the code here.
    </p>

    <.code_form action={~p"/sign-in/code"} email={@email} error_message={@error_message} />

    <p class="text-sm text-center mt-6 opacity-70 mx-auto max-w-sm">
      Nothing arrived? Check your spam folder, or <.link navigate={~p"/sign-in"} class="link link-primary">start again</.link>.
    </p>
  </div>
</Layouts.app>
