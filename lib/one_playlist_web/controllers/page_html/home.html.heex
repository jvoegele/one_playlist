<%!--
  The landing page, and — more to the point — where everything redirects back
  to: the TIDAL OAuth callback, dev sign-in and sign-out, and
  `UserAuth.require_authenticated_user/2` turning away a signed-out visitor.
  It renders inside `Layouts.app` so that all of those arrive somewhere with
  navigation, rather than on a page whose only way onward is the URL bar.
--%>
<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="py-10 sm:py-16">
    <h1 class="text-4xl font-semibold tracking-tight text-balance">
      Move a playlist, and see what happened to every track.
    </h1>

    <p class="mt-4 text-lg leading-8 opacity-70 max-w-2xl">
      One Playlist copies playlists between streaming services and your own
      server. Every track that could not be matched is reported, with the reason —
      because a transfer that silently drops nine tracks looks exactly like one
      that worked.
    </p>

    <div :if={@current_scope} class="mt-8 flex flex-wrap gap-3">
      <.link navigate={~p"/transfers/new"} class="btn btn-primary">
        Start a transfer
      </.link>
      <.link navigate={~p"/connections"} class="btn btn-ghost">
        <.icon name="hero-link" class="w-4 h-4" /> Connect a service
      </.link>
    </div>

    <div :if={!@current_scope} class="mt-8">
      <p class="opacity-70">Sign in to connect a service.</p>
    </div>

    <div class="mt-16 grid gap-6 sm:grid-cols-3">
      <div>
        <.icon name="hero-musical-note" class="w-6 h-6 text-primary" />
        <h2 class="mt-2 font-medium">Matched properly</h2>
        <p class="mt-1 text-sm opacity-70">
          ISRC first, then the release barcode, then title and artist — with a
          confidence score, and a veto on live and karaoke versions pretending
          to be the studio recording.
        </p>
      </div>

      <div>
        <.icon name="hero-server-stack" class="w-6 h-6 text-primary" />
        <h2 class="mt-2 font-medium">Your own server too</h2>
        <p class="mt-1 text-sm opacity-70">
          Navidrome, Airsonic, Gonic and Subsonic are first-class destinations,
          not an afterthought — no quota, no allowlist.
        </p>
      </div>

      <div>
        <.icon name="hero-arrow-path-rounded-square" class="w-6 h-6 text-primary" />
        <h2 class="mt-2 font-medium">Safe to run twice</h2>
        <p class="mt-1 text-sm opacity-70">
          A transfer takes a snapshot and adds only what is missing, so re-running
          a half-finished one finishes it rather than duplicating it.
        </p>
      </div>
    </div>
  </div>
</Layouts.app>
